# This workspace also contains an original game installation and extraction dumps.
# Track the browser project explicitly; leave all other top-level files local.
/*
!/.gitignore
!/.gitattributes
!/*.md
!/LICENSE
!/CITATION.cff
!/.github/
!/package.json
!/package-lock.json
!/wrangler.jsonc
!/*.cmd
!/.tools/
!/test/
!/docs/
!/export/
/export/*
!/export/web/
!/artifacts/
/artifacts/*
!/artifacts/social-preview/

# Local tools, credentials, dependencies, caches, and generated reports.
node_modules/
__pycache__/
*.pyc
*.exe
*.dll
.env
.env.*
.dev.vars
.dev.vars.*
*.pem
*.key
*.log
*.pid
.DS_Store
Thumbs.db

# Rind launcher downloads and update feed (built and copied by ~/projects/rind/scripts/release.sh)
/export/web/rind/

# KTX2 copies of the game textures (.tools/build-ktx2.mjs): derived from ripped assets, rebuilt locally
/export/web/ktx2/


# Gzip copies for the static server (.tools/build-gz.mjs), rebuilt locally; the few .gz assets the game loads itself stay tracked
/export/web/**/*.glb.gz
/export/web/**/*.bin.gz
/export/web/**/*.json.gz
/export/web/**/*.wasm.gz
!/export/web/mods/lighting/*.bin.gz

# Season 1 (s2) pass camos, calling cards and emblems (2026-11-08): third-party textures the user supplied (2026-11-06), kept local like the ripped assets
/export/web/mods/weapon-levels/camos/s2/
/export/web/mods/shop/cards/s2/
/export/web/mods/shop/emblems/s2/
# Season 1 hit sounds the user supplied (2026-11-07: a free-sound-effect taser zap and two hitmarker sounds of unknown origin), kept local too
/export/web/mods/shop/sounds/*
# except Funeral Bells, synthesised by .tools/build-bell-sounds.py (ours)
!/export/web/mods/shop/sounds/bell[123].wav

# weapon sticker images: the six Season 1 ones are the user's own (2026-11-07) and are published; the test smiley's origin is unknown, so it stays local
/export/web/mods/stickers/images/smiley.png
# the Kurb charm's scan: user, 2026-11-07: "kurb scan doesnt go in" (never commit or install it)
/export/web/mods/charms/models/kurb.glb
